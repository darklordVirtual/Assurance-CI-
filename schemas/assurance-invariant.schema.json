{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darklordVirtual/Assurance-CI-/raw/main/schemas/assurance-invariant.schema.json",
  "title": "Assurance Invariant Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invariants"],
  "properties": {
    "schema_version": {"const": "assurance-invariants/v1"},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "criticality", "affected_surface", "threat_scenario",
          "preconditions", "predicate", "postconditions", "required_producers",
          "failure_treatment", "owner"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^ACI-INV-[0-9]{3,}$"},
          "title": {"type": "string", "minLength": 1},
          "criticality": {"enum": ["critical", "high", "medium", "low"]},
          "affected_surface": {"type": "string", "minLength": 1},
          "threat_scenario": {"type": "string", "minLength": 1},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "predicate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "expression"],
            "properties": {
              "language": {"const": "assurance-expression/v1"},
              "expression": {"type": "string", "minLength": 1}
            }
          },
          "postconditions": {"type": "array", "items": {"type": "string"}},
          "required_producers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "failure_treatment": {"enum": ["block", "escalate"]},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

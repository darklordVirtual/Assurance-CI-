{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darklordVirtual/Assurance-CI-/raw/main/schemas/assurance-profile.schema.json",
  "title": "Assurance Profile",
  "description": "Revision-controlled policy selecting required evidence and failure treatment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "revision_binding",
    "failure_posture",
    "required_aggregators",
    "critical_outcomes_allowed",
    "non_success_outcomes",
    "evidence_requirements"
  ],
  "properties": {
    "schema_version": {"const": "assurance-profile/v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "revision_binding": {"const": "exact_commit"},
    "failure_posture": {"const": "fail_closed"},
    "required_aggregators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "producers"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "producers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "critical_outcomes_allowed": {
      "type": "array",
      "maxItems": 1,
      "items": {"const": "PASSED"}
    },
    "non_success_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FAILED", "BLOCKED", "INCONCLUSIVE", "NOT_APPLICABLE"],
      "properties": {
        "FAILED": {"const": "block"},
        "BLOCKED": {"const": "block"},
        "INCONCLUSIVE": {"const": "block"},
        "NOT_APPLICABLE": {"const": "require_signed_applicability_decision"}
      }
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_digest", "policy_digest", "artifact_digests", "claim_mapping"],
      "properties": {
        "workflow_digest": {"const": true},
        "policy_digest": {"const": true},
        "artifact_digests": {"const": true},
        "claim_mapping": {"const": true}
      }
    }
  }
}
